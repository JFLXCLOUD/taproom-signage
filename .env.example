# Admin password for the control PWA. CHANGE THIS.
ADMIN_PASSWORD=changeme

# Port the app listens on
PORT=8080

# Where the SQLite db + uploaded images live (mount this as a volume)
DATA_DIR=./data

# Optional: seed demo taps on first boot so the display isn't empty
SEED_DEMO=1

# Set to 1 ONLY when this box is itself the Wi-Fi access point (the Raspberry Pi
# image). Phones probing for internet are then redirected to the admin app, so
# they pop it open on joining and nobody types an address.
# Leave unset if the network has real internet, or every device will think it is
# offline.
CAPTIVE_PORTAL=0
